# LLM provider: ollama | gemini | openai | groq | cloudflare
# Generate primary. Embeddings use LLM_EMBEDDING_PROVIDER (defaults to LLM_PROVIDER).
LLM_PROVIDER=cloudflare
LLM_EMBEDDING_PROVIDER=gemini

# Ollama (local, free) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1
# Chat model: llama3.2 = faster (default for local demos); llama3.1:8b = more accurate but slower.
OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_API_KEY=ollama

# Google Gemini — used for both document and query embeddings
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for active models on your account.
GROQ_CHAT_MODEL=

# Cloudflare Workers AI — https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.2-3b-instruct

# PostgreSQL + pgvector (matches docker-compose.yml)
# If 5432 is already used by a local Postgres, change this (e.g. 5433)
DB_HOST=localhost
# 5432 is taken by a native Postgres on this machine; use 5433 for the container
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_knowledge
# Set true for managed Postgres (Neon/Supabase/Render); false for local docker
DB_SSL=false

# AI Gateway 4.1 — USD per 1M tokens (assumed rates for demos; Ollama is free in reality)
OLLAMA_INPUT_USD_PER_1M=0.02
OLLAMA_OUTPUT_USD_PER_1M=0.08
OPENAI_INPUT_USD_PER_1M=0.15
OPENAI_OUTPUT_USD_PER_1M=0.60
GEMINI_INPUT_USD_PER_1M=0.075
GEMINI_OUTPUT_USD_PER_1M=0.30
# Defaults to zero for Groq's free-tier usage; set nonzero rates if applicable.
GROQ_INPUT_USD_PER_1M=0
GROQ_OUTPUT_USD_PER_1M=0
# Gateway cost estimates default to zero within Cloudflare's free allocation.
# Monitor the daily Neuron quota; exceeding the Free plan allocation fails requests.
CLOUDFLARE_INPUT_USD_PER_1M=0
CLOUDFLARE_OUTPUT_USD_PER_1M=0

# AI Gateway 4.2 — generate fallback (embeddings use LLM_EMBEDDING_PROVIDER)
# Primary is LLM_PROVIDER; then unique names from this list; capped by MAX_ATTEMPTS
# Cloudflare handles answer generation; Gemini handles embeddings.
LLM_FALLBACK_ORDER=cloudflare
# 10000 demos timeout→fallback; use 45000+ for local CPU RAG with Ollama
LLM_TIMEOUT_MS=45000
LLM_MAX_ATTEMPTS=1

# Rate limiting (per IP) — protects public LLM endpoints
THROTTLE_TTL=60
THROTTLE_LIMIT=30

PORT=3000
